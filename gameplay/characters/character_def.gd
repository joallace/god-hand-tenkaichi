class_name CharacterDef
extends Resource
## A playable character: identity, look, moveset and optional stat overrides.
## Saved in data/characters/<id>.tres (generated by tools/generate_moves.gd).

@export var id: StringName = &""
@export var display_name: String = ""
@export var color: Color = Color(0.8, 0.4, 0.2)
## Every move the character can perform (normals, specials, payloads).
@export var moves: Array[MoveData] = []

@export_group("Move roles")
## LIGHT string in order; chained through each move's `cancel_into`.
@export var light_string: Array[StringName] = []
## Standalone HEAVY from neutral.
@export var heavy: StringName = &""
## HEAVY after any light in the string (reached via `cancel_into`).
@export var finisher: StringName = &""
@export var jump_attack: StringName = &""
@export var dash_attack: StringName = &""
@export var ki_blast: StringName = &""
## Neutral SPECIAL.
@export var super1: StringName = &""
## Back + SPECIAL.
@export var super2: StringName = &""
## Forward + SPECIAL with a full gauge.
@export var ultimate: StringName = &""

@export_group("Stats")
## FighterTuning property name -> value, applied on a per-fighter copy.
@export var stat_overrides: Dictionary = {}


func move(move_id: StringName) -> MoveData:
	for m in moves:
		if m.id == move_id:
			return m
	return null


## Shared tuning, or a private copy with this character's overrides applied.
func build_tuning(base: FighterTuning) -> FighterTuning:
	if stat_overrides.is_empty():
		return base
	var t: FighterTuning = base.duplicate()
	for key: Variant in stat_overrides:
		t.set(StringName(key), stat_overrides[key])
	return t
