class_name MoveData
extends Resource
## One attack (or projectile/beam hit payload). Pure data; Fighter runs it.
## Generated by tools/generate_moves.gd into data/moves/<id>.tres.
##
## Frame timeline (frames counted from the frame the move starts):
##   [0, startup)                     startup   (no hitbox)
##   [startup, startup + active)      active    (hitbox live)
##   [startup + active, total())      recovery
##
## Fighter space for vectors: x = right, y = up, z = forward (toward the
## target / along the attack direction).
##
## Charge strikes (`charge_frame` >= 0): the move pauses at `charge_frame`
## while its button stays held, accumulating up to `charge_max_frames`; on
## release (or full charge) it continues, with damage, guard ki cost, stun and
## guard break scaled by the charge ratio (see FighterTuning "Charge strikes").

## Strike height, picked with the stick when several HEAVY moves are
## candidates (forward = HIGH, neutral = MID, back = LOW). HIGH whiffs over
## a ducking opponent; LOW hits one.
## The same enum doubles as the guard pose (stick forward = HIGH guard,
## neutral = MID, back = LOW).
enum Height { MID, HIGH, LOW }
## What a guard does against this move (BT3 style, one result per guard pose):
##   PLAIN        guard stun + pushback
##   KI_GUARD     also drains `guard_ki_cost` ki (half push); at 0 ki the
##                guard crashes
##   PUSH_OFF     the attacker recoils; the defender gains a little ki
##   PUSH_STOP    push-off plus a short freeze of both fighters
##   UNBLOCKABLE  goes through that pose as a clean hit
enum GuardResult { PLAIN, KI_GUARD, PUSH_OFF, PUSH_STOP, UNBLOCKABLE }

@export var id: StringName = &""
## Which button selects this move when it appears in a `cancel_into` list.
## An InputFrame.Btn value (0 = never selected by button, e.g. auto-chains).
@export var button: int = 0
## Visual pose id (FighterVisual interprets it).
@export var pose: StringName = &""
@export var height: Height = Height.MID

@export_group("Timing")
@export var startup: int = 5
@export var active: int = 3
@export var recovery: int = 12

@export_group("Hit")
@export var damage: float = 30.0
@export var hitstun: int = 18
@export var guard_stun: int = 10
## Initial velocity given to the victim (m/s, attacker space: z pushes away).
@export var knockback: Vector3 = Vector3(0, 0, 1.5)
## Victim is knocked down (launched with `knockback`, lands lying down).
@export var knockdown: bool = false
## Ki drained from the defender when the guard result is KI_GUARD.
@export var guard_ki_cost: float = 5.0
## GuardResult per guard pose, indexed by Height (MID, HIGH, LOW).
@export var guard_results: Array[int] = [GuardResult.PLAIN, GuardResult.PLAIN, GuardResult.PLAIN]
## Unblockable in every pose (overrides guard_results).
@export var is_unblockable: bool = false
## Grab: goes through any guard and can't be blocked, only broken with a
## timed GUARD press (see FighterTuning "Throws"). Damage, knockback and
## knockdown apply when the throw executes.
@export var is_throw: bool = false
## A clean hit slams the victim into the floor and bounces them back up.
@export var ground_bounce: bool = false
## Heavy hits use the heavy hitstop and drive bigger presentation reactions.
@export var is_heavy: bool = false
## Global hitstop on hit; -1 = Tuning.fighter.hitstop_light/heavy.
@export var hitstop: int = -1
## Bonus ki for the attacker on hit (added to ki_gain_on_hit_dealt).
@export var ki_gain: float = 0.0
## False for supers so spending ki doesn't refund it.
@export var grants_hit_ki: bool = true
## >0: the hitbox re-arms every N active frames (multi-hit beams/rushes).
@export var multi_hit_interval: int = 0
## Connects with its first victim only (rush supers); otherwise an activation
## hits every fighter it overlaps once (beams pierce, strikes cleave crowds).
@export var single_target: bool = false

@export_group("Hitbox")
## Center of the hitbox (fighter space). For capsules, the start point.
@export var hitbox_offset: Vector3 = Vector3(0, 1.4, 0.9)
@export var hitbox_radius: float = 0.45
## >0 makes a capsule extending forward (+z) from hitbox_offset by this length.
## Beams: the maximum length the head travels out to (see `travel_speed`).
@export var hitbox_length: float = 0.0
## Hits all around (spinning sweeps): knockback, push-off recoil and loop
## push-outs point from the attacker's center toward each victim instead of
## along the attacker's facing. Center the hitbox on the body (z = 0).
@export var radial: bool = false

@export_group("Movement")
## Forward speed (m/s) applied for `lunge_frames` frames from `lunge_start`.
@export var lunge_speed: float = 0.0
@export var lunge_start: int = 0
@export var lunge_frames: int = 0
## Frames (from move start) during which the attacker still turns to track.
## -1 = track through startup.
@export var track_frames: int = -1
## Started airborne: the attacker stalls in the air (no gravity, no drift)
## for this many frames; -1 = the whole move (air beams). A lunge started in
## the air dives toward the opponent instead (see Fighter._dive_velocity).
@export var air_hang_frames: int = 0
## Touching down ends the move (jump attacks).
@export var land_cancel: bool = false
## Low stance: the hurtbox shrinks to FighterTuning.duck_height for the whole
## move, so HIGH strikes whiff over it (duck kick).
@export var low_profile: bool = false

@export_group("Cancels")
## Window (frames from move start, inclusive) in which `cancel_into` is open.
@export var cancel_start: int = 0
@export var cancel_end: int = 0
@export var cancel_into: Array[StringName] = []
## If true the cancel window only opens after the move connected (hit/block).
@export var cancel_requires_hit: bool = false
## Can be canceled into a super (on hit/block) during the cancel window.
@export var special_cancelable: bool = false
## When the move connects, this move starts automatically after its active
## frames (super rush auto combo).
@export var auto_next_on_hit: StringName = &""
## Charge strike this move turns into when its button is held for
## FighterTuning.charge_hold_frames (outside the active frames).
@export var charge_move: StringName = &""
## Charge strikes only: directional smashes swapped in on release by the
## stick, in order [forward, back, left, right] (&"" = keep this move). They
## must share this move's charge_frame / charge_max_frames.
@export var smash_variants: Array[StringName] = []

@export_group("Charge")
## Frame the move holds at while charging; -1 = not a charge strike.
@export var charge_frame: int = -1
## Frames of holding needed for a full charge (auto-releases there).
@export var charge_max_frames: int = 0
## Damage / guard damage multipliers at full charge (lerped from 1).
@export var charge_damage_mult: float = 1.0
@export var charge_guard_mult: float = 1.0

@export_group("Spawning")
## &"ki_blast" or &"beam": entity spawned at `spawn_frame` using `spawn_move`
## as its hit payload.
@export var spawn_kind: StringName = &""
@export var spawn_frame: int = 0
@export var spawn_move: MoveData
## Projectiles: travel speed (m/s) and lifetime (frames). Beams use `active`
## as their duration (travel out + sustain at full length) and
## `travel_speed` as the speed of the beam's head growing out from the
## caster's hands (<= 0: full `hitbox_length` on the first frame).
@export var travel_speed: float = 0.0
@export var lifetime_frames: int = 0
## Beams: the head turns toward the caster's target by up to this many
## degrees per frame while it grows (0 = flies straight).
@export var beam_homing_deg: float = 0.0
## Beams: homing stops for good once the head is within this distance (m)
## of the target or has passed it, so a late sidestep gets out of the line.
@export var beam_homing_stop_distance: float = 0.0
## Beams: while homing bends the head, its position is kept as a trail point
## every N frames; the beam (hitbox and mesh) is the polyline hands -> trail
## points -> head.
@export var beam_trail_sample_frames: int = 4


func total() -> int:
	return startup + active + recovery


func is_active_frame(frame: int) -> bool:
	return frame >= startup and frame < startup + active


func is_charge_strike() -> bool:
	return charge_frame >= 0 and charge_max_frames > 0


func guard_result(pose: Height) -> GuardResult:
	if is_unblockable:
		return GuardResult.UNBLOCKABLE
	if pose < guard_results.size():
		return guard_results[pose] as GuardResult
	return GuardResult.PLAIN


func hitstop_frames(t: FighterTuning) -> int:
	if hitstop >= 0:
		return hitstop
	return t.hitstop_heavy if is_heavy else t.hitstop_light
