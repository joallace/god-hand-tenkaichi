# Copy to server/.env and edit. Read by docker-compose.yml (both services)
# and usable as plain env vars for `python3 server/signaling_server.py`.
# Every GHT_SIGNAL_* limit is listed in server/README.md.

# --- Signaling ---
GHT_SIGNAL_PORT=8765
# Host port to publish (docker compose only).
GHT_SIGNAL_PUBLISH=8765
# wss:// directly from the container (files under GHT_CERT_DIR, mounted at /certs):
#GHT_SIGNAL_CERT=/certs/fullchain.pem
#GHT_SIGNAL_KEY=/certs/privkey.pem
# Or behind your own TLS reverse proxy (it must set X-Forwarded-For):
#GHT_SIGNAL_TRUST_PROXY=1
GHT_SIGNAL_LOG_LEVEL=INFO

# --- ICE ---
GHT_STUN_URLS=stun:stun.l.google.com:19302
# TURN (docker compose --profile turn). Leave GHT_TURN_URLS empty to offer STUN only.
#GHT_TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
# Long random string, shared by the signaling server and coturn: openssl rand -hex 32
GHT_TURN_SECRET=
GHT_TURN_TTL=21600

# --- coturn ---
GHT_TURN_REALM=turn.example.com
GHT_TURN_MIN_PORT=49160
GHT_TURN_MAX_PORT=49200
#GHT_TURN_EXTERNAL_IP=203.0.113.10

# Directory holding fullchain.pem + privkey.pem (both services mount it).
GHT_CERT_DIR=./certs
